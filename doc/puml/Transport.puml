TransportCongestionControlServer <- Transport : tccClient
TransportCongestionControlServer <- Transport : tccServer
Transport -> SctpAssociation : sctpAssociation

RateCalculator <-- Transport : recv/sendTransmission
RtpDataCounter <-- Transport : recv/sendRtpTransmission
RtpDataCounter <-- Transport : sendRtxTransmission
