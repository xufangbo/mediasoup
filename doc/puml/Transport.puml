Transport <|-- PlainTransport

TransportTuple <- PlainTransport : tuple
TransportTuple <- PlainTransport : rtcpTuple

PlainTransport --> UdpSocket : udpSocket
PlainTransport --> UdpSocket : rtcpUdpSocket

PlainTransport --> SrtpSession : srtpRecvSession
PlainTransport --> SrtpSession : srtpSendSession

' ---------------------------------------
Transport <|-- WebRtcTransport

WebRtcTransport --> IceServer
IceCandidate <-* WebRtcTransport : iceCandidates

WebRtcTransport --> SrtpSession : srtpRecvSession
WebRtcTransport --> SrtpSession : srtpSendSession

WebRtcTransport --> DtlsTransport : dtlsTransport

WebRtcTransport --> UdpSocket : udpSockets
WebRtcTransport --> TcpServer : tcpServers

